{
  "name": "rtq-review-content-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "start": "next start",
    "check": "pnpm format:check && pnpm lint:check && pnpm types && pnpm test && pnpm database:tracking:check && pnpm build",
    "database:tracking:check": "node scripts/database-tracking-check.mjs",
    "lint": "pnpm lint:check",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "node --no-warnings --test --experimental-strip-types src/db/review-comments.test.ts src/lib/paper-asset-reader.test.ts src/lib/paper-list-markdown.test.ts src/lib/paper-table-markdown.test.ts src/lib/review-interface.test.ts src/lib/review-server.test.ts src/lib/review-view-model.test.ts src/lib/rtq-katex.test.ts src/lib/source-freshness.test.ts src/lib/working-sections.test.ts src/lib/workspace-view-model.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@rtq/review-katex-options": "workspace:*",
    "@rtq/review-paper-markdown": "workspace:*",
    "@rtq/review-paper-model": "workspace:*",
    "@rtq/review-repository-paths": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "katex": "^0.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5"
  }
}
