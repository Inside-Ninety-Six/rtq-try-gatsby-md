  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:check",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "node --no-warnings --test --experimental-strip-types src/lib/paper-asset-reader.test.ts src/lib/paper-list-markdown.test.ts src/lib/review-outcomes.test.ts src/lib/rtq-katex.test.ts src/lib/working-collections-markdown.test.ts",
    "types": "tsc --noEmit",
    "dev:remote": "NODE_OPTIONS=--use-system-ca RTQ_REVIEW_API_BASE_URL=https://rtq-review-api.ngrok.app next dev"
